{
  "name": "ctrl",
  "productName": "ctrl",
  "version": "1.2.2",
  "description": "Otimizador de Windows que guarda o valor original de cada ajuste, verifica se o Windows desfez algo e desfaz qualquer alteração.",
  "main": "electron/main.cjs",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "check": "node scripts/check-catalog.cjs",
    "dist": "vite build && electron-builder --win nsis",
    "lint": "eslint .",
    "verify-rules": "node scripts/verify-quality-rules.mjs",
    "verify": "npm run lint && npm run verify-rules && npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.rodolfoxm.ctrl",
    "productName": "ctrl",
    "copyright": "Copyright © 2026 rodolfoxm",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ctrl",
      "uninstallDisplayName": "ctrl",
      "artifactName": "ctrl-Setup-${version}.${ext}",
      "license": "build/terms.txt",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "pt_BR"
      ],
      "multiLanguageInstaller": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    }
  },
  "author": "rodolfoxm",
  "homepage": "https://github.com/rodolfoxm/ctrl",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodolfoxm/ctrl.git"
  },
  "private": true
}
